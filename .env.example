# ============================================================
# .env.example — ZeroTrust Auth Platform
# Copiar a .env y llenar con valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# ── PostgreSQL (Authentication Service) ──
POSTGRES_AUTHN_DB=zerotrust_authn
POSTGRES_AUTHN_USER=authn_user
POSTGRES_AUTHN_PASSWORD=CHANGE_ME

# ── PostgreSQL (Authorization Service) ──
POSTGRES_AUTHZ_DB=zerotrust_authz
POSTGRES_AUTHZ_USER=authz_user
POSTGRES_AUTHZ_PASSWORD=CHANGE_ME

# ── MongoDB (Audit Log Service) ──
MONGODB_AUDIT_DB=zerotrust_audit
MONGODB_AUDIT_USER=audit_user
MONGODB_AUDIT_PASSWORD=CHANGE_ME

# ── MongoDB (ML / Anomaly Detection) ──
MONGODB_ML_DB=zerotrust_ml
MONGODB_ML_USER=ml_user
MONGODB_ML_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── Kafka ──
KAFKA_BROKER=kafka:9092

# ── JWT (claves RSA) ──
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
